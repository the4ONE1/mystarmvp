# Copy to .env.local for local development. In production (Vercel), set these
# as Project Environment Variables instead of committing a .env file.
#
# Nothing here is optional for a *working* purchase pipeline except where
# noted — if a required var is missing, the corresponding step degrades
# silently (see the file it's used in) instead of throwing, so it's easy to
# end up "half configured" without noticing. Check GET /api/health.

# ── Stripe (required) ────────────────────────────────────────────────────
# https://dashboard.stripe.com/apikeys — use sk_test_/pk_test_ for testing
# with card 4242 4242 4242 4242, sk_live_/pk_live_ for real payments.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# From Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret.
# The endpoint URL must be: https://<your-domain>/api/webhooks/stripe (lowercase).
STRIPE_WEBHOOK_SECRET=whsec_...

# One-time Price IDs from Stripe Dashboard > Product catalog.
STRIPE_PRICE_MAIN_STORY=price_...
STRIPE_PRICE_AUDIOBOOK=price_...
STRIPE_PRICE_COLORING_BOOK=price_...
STRIPE_PRICE_ADDITIONAL_CHARACTER=price_...

# Public origin used to build Stripe success/cancel URLs and to call this
# app's own /api/generate-story endpoint from the webhook handler.
NEXT_PUBLIC_BASE_URL=https://mestar.pro

# ── Supabase (required — order storage) ──────────────────────────────────
# Run supabase_schema.sql in the Supabase SQL editor first.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── AWS S3 (required — PDF + photo storage) ──────────────────────────────
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
S3_BUCKET_NAME=...

# ── Story generation (optional, has a free fallback) ─────────────────────
# Without this, lib/story.js generates a fixed placeholder story instead of
# an OpenAI one — the pipeline still runs end-to-end, just not personalized
# beyond the child's name/theme. gpt-4o-mini costs roughly $0.01-0.02/story,
# negligible against a $19.99 sale.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Email delivery (required to actually notify customers) ───────────────
# https://resend.com — free tier: 3,000 emails/month, 100/day. Without this,
# emails are silently skipped (see lib/email.js) and the customer only finds
# out their order is ready if they revisit /order-confirmation.
RESEND_API_KEY=re_...
# Must be on a domain you've verified in Resend.
RESEND_FROM_EMAIL="MyStar Stories <noreply@mestar.pro>"

# ── Internal (optional but recommended) ───────────────────────────────────
# Shared secret so /api/generate-story only accepts calls from the webhook
# handler, not arbitrary requests that would trigger free generation.
INTERNAL_API_SECRET=
