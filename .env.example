# MyStarStories (mystarmvp) — environment variables
#
# Copy this file to .env.local (local dev) and set the same keys in your
# hosting provider's dashboard (e.g. Vercel → Project → Settings →
# Environment Variables) for staging/production.
#
# ARCHITECTURE NOTE: checkout, order storage, and photo storage are handled
# by the ktkebsvoqbxsirgluxeo Supabase project — NOT mestar's project
# (gqgloucjqvhbbjyxfgqw), which this account cannot access. This project has
# its own Edge Functions (create-pending-order / create-checkout /
# get-order-status / stripe-webhook / create-storybook / send-story-email)
# and its own orders/stories tables — same contract mestar's frontend used,
# different backend project. This app no longer talks to Stripe or AWS S3
# directly — there is no STRIPE_SECRET_KEY, no AWS_* here, because those
# secrets live only in that project's Edge Function secrets, not here.
# Everything below is intentionally public/client-safe.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# ktkebsvoqbxsirgluxeo Supabase project (anon key only — safe to expose;
# protected by Row Level Security + the Edge Functions' own validation, not
# by secrecy). Dashboard: https://supabase.com/dashboard/project/ktkebsvoqbxsirgluxeo
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://ktkebsvoqbxsirgluxeo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imt0a2Vic3ZvcWJ4c2lyZ2x1eGVvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODI5NjU1NDIsImV4cCI6MjA5ODU0MTU0Mn0.7tKihYUTta1i6ln9D8RUbAhba29iY6ePTk1FI7_nFRo

# ---------------------------------------------------------------------------
# Stripe publishable key (client-side, for the embedded Checkout UI only —
# the actual session is created server-side by create-checkout). Same Stripe
# account as mestar (acct_1T45wEEFjF8b7r2p / "mE-STAR"), same Price lookup
# keys. This is the TEST key by default here — use a pk_live_... key from
# the same Stripe account in your production environment variables instead.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51Ttt4nGkH5A1tO6iihvLWbztPa7K6otQ5a1C5R7VoKLrLnk68hdUAlT3F6ImJeaKS5xwW2t4eGp4EHTT4cRAkEj800FVXSr0Zb

# ---------------------------------------------------------------------------
# Analytics & tracking — all public, all optional (components no-op and load
# nothing if unset). Direct equivalents of mestar's VITE_GA_ID / VITE_GTM_ID /
# VITE_META_PIXEL_ID / VITE_GOOGLE_ADS_ID / VITE_GOOGLE_ADS_CONVERSION_LABEL.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
