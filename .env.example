# MyStarStories (mystarmvp) — environment variables
#
# Copy this file to .env.local (local dev) and set the same keys in your
# hosting provider's dashboard (e.g. Vercel → Project → Settings →
# Environment Variables) for staging/production.
#
# ARCHITECTURE NOTE: as of this pass, checkout, order storage, and photo
# storage are handled entirely by mestar's Supabase project (Edge Functions
# create-pending-order / create-checkout, private "customer-photos" bucket,
# storybook_orders table). This app no longer talks to Stripe or AWS S3
# directly — there is no STRIPE_SECRET_KEY, no AWS_* here, because those
# secrets live only in mestar's Supabase Edge Function secrets, not here.
# Everything below is intentionally public/client-safe.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# mestar's Supabase project (anon key only — safe to expose; protected by
# Row Level Security + the Edge Functions' own validation, not by secrecy).
# Same values as mestar's VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://gqgloucjqvhbbjyxfgqw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdxZ2xvdWNqcXZoYmJqeXhmZ3F3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzUyMzgwMjEsImV4cCI6MjA5MDgxNDAyMX0.MQ9w8FY6maFP-ue_1Qzar5qoOPj5Z_BQmUp4poA0UYE

# ---------------------------------------------------------------------------
# Stripe publishable key (client-side, for the embedded Checkout UI only —
# the actual session is created server-side by mestar's create-checkout
# Edge Function). Same value as mestar's VITE_PAYMENTS_CLIENT_TOKEN.
# This is mestar's TEST key by default here; use the pk_live_... key from
# mestar's .env.production in your production environment variables instead.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51Ttt4nGkH5A1tO6iihvLWbztPa7K6otQ5a1C5R7VoKLrLnk68hdUAlT3F6ImJeaKS5xwW2t4eGp4EHTT4cRAkEj800FVXSr0Zb

# ---------------------------------------------------------------------------
# Analytics & tracking — all public, all optional (components no-op and load
# nothing if unset). Direct equivalents of mestar's VITE_GA_ID / VITE_GTM_ID /
# VITE_META_PIXEL_ID / VITE_GOOGLE_ADS_ID / VITE_GOOGLE_ADS_CONVERSION_LABEL.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
