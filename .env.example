# =============================================================================
# MyStarStories — Environment Variables
# Copy this file to .env.local for local development.
# In production, set these in the Vercel Dashboard under
# Project → Settings → Environment Variables.
# =============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# The publicly accessible URL of the deployed app (no trailing slash).
# Local:      http://localhost:3000
# Production: https://mystarstories.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase  (https://app.supabase.com)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------------
# Stripe  (https://dashboard.stripe.com)
# Use sk_test_ / pk_test_ keys for development; sk_live_ / pk_live_ for production.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY

# Stripe Price IDs — create products in the Stripe Dashboard and paste the
# price_* IDs here.
STRIPE_PRICE_MAIN_STORY=price_YOUR_MAIN_STORY_PRICE_ID
STRIPE_PRICE_AUDIOBOOK=price_YOUR_AUDIOBOOK_PRICE_ID
STRIPE_PRICE_COLORING_BOOK=price_YOUR_COLORING_BOOK_PRICE_ID
STRIPE_PRICE_ADDITIONAL_CHARACTER=price_YOUR_ADDITIONAL_CHARACTER_PRICE_ID

# Webhook secret — from Stripe Dashboard → Developers → Webhooks.
# Production endpoint: https://mystarstories.app/api/webhooks/stripe
# Events: checkout.session.completed, payment_intent.succeeded
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ---------------------------------------------------------------------------
# AWS S3  (https://console.aws.amazon.com/s3)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1
S3_BUCKET_NAME=mystarstories-photos

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=XXXXXXXXXXXXXXXXXX
