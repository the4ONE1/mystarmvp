# MyStarStories (mystarmvp) — environment variables
#
# Copy this file to .env (local dev) and set the same keys in your hosting
# provider's dashboard (e.g. Vercel → Project → Settings → Environment Variables)
# for staging/production. Never commit real values — .env* is git-ignored.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time.
# Only put values here that are safe to expose publicly (analytics IDs,
# non-secret Stripe Price IDs). Everything else must stay server-only.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public site URL, used for Stripe success/cancel redirects, canonical/OG tags,
# and JSON-LD. Corresponds to the React app's implicit window.location origin.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Stripe — server-only secrets (equivalents to React's Supabase Edge Function
# secrets PAYMENTS_LIVE_WEBHOOK_SECRET / PAYMENTS_SANDBOX_WEBHOOK_SECRET)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_actual_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs used server-side to build the Checkout Session line items
# (app/api/create-checkout-session/route.js is authoritative — client-supplied
# price IDs are never trusted). These are Stripe Price IDs specific to this
# app's own Stripe product catalog; they are NOT the same values as the React
# app's VITE_STRIPE_PRICE_* lookup keys (different Stripe products/catalog).
STRIPE_PRICE_MAIN_STORY=price_your_main_story_price_id
STRIPE_PRICE_AUDIOBOOK=price_your_audiobook_price_id
STRIPE_PRICE_COLORING_BOOK=price_your_coloring_book_price_id
STRIPE_PRICE_ADDITIONAL_CHARACTER=price_your_additional_character_price_id

# Public copies of the add-on Price IDs, used only for display/labeling in
# app/checkout/page.js. Price IDs are not secret; the server never trusts
# these values. Keep in sync with the server-only vars above.
NEXT_PUBLIC_STRIPE_PRICE_AUDIOBOOK=price_your_audiobook_price_id
NEXT_PUBLIC_STRIPE_PRICE_COLORING_BOOK=price_your_coloring_book_price_id
NEXT_PUBLIC_STRIPE_PRICE_ADDITIONAL_CHARACTER=price_your_additional_character_price_id

# ---------------------------------------------------------------------------
# Supabase — server-only (service role key bypasses RLS; never expose to the
# browser). This is a dedicated Supabase project for this app's `orders`
# table (see supabase_schema.sql) — a different project from the React app's
# Supabase backend, which has its own richer schema and Edge Functions.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---------------------------------------------------------------------------
# AWS S3 — server-only, used for presigned photo upload URLs
# (equivalent integration to the React app's Supabase Storage usage)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name-here

# ---------------------------------------------------------------------------
# Analytics & tracking — all public, all optional (components no-op and load
# nothing if unset). Direct equivalents of the React app's VITE_GA_ID /
# VITE_GTM_ID / VITE_META_PIXEL_ID / VITE_GOOGLE_ADS_ID /
# VITE_GOOGLE_ADS_CONVERSION_LABEL.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
