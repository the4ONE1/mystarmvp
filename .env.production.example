# App
NEXT_PUBLIC_BASE_URL=https://your-production-domain.com
NODE_ENV=production

# Database
MONGO_URL=mongodb://localhost:27017
DB_NAME=mestar_storybooks

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_actual_key_here
STRIPE_SECRET_KEY=sk_live_your_actual_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_ID=price_your_price_id_here
STRIPE_PRICE_MAIN_STORY=price_main_story_here
STRIPE_PRICE_AUDIOBOOK=price_audiobook_here
STRIPE_PRICE_COLORING_BOOK=price_coloring_book_here
STRIPE_PRICE_ADDITIONAL_CHARACTER=price_additional_character_here
